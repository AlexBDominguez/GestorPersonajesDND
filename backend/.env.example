# Variables de entorno requeridas para producción
# ================================================
# NUNCA commits los valores reales a git. Usar un secret manager (AWS Secrets Manager, Azure Key Vault, etc.)

# MySQL - Credenciales de base de datos
# Generar contraseñas seguras: pwgen -s 24 1 (o similar en tu SO)
MYSQL_ROOT_PASSWORD=change_this_root_password_min_12_chars_secure
MYSQL_USER=dnd_app_user
MYSQL_PASSWORD=change_this_user_password_min_12_chars_secure

# Spring Boot - Credenciales de datasource (repetir contraseña de MYSQL_PASSWORD)
SPRING_DATASOURCE_USERNAME=dnd_app_user
SPRING_DATASOURCE_PASSWORD=change_this_user_password_min_12_chars_secure

# JWT - Clave secreta para tokens (mínimo 32 caracteres, idealmente 64+ para HS256)
# Generar: openssl rand -base64 44
JWT_SECRET=change_this_very_long_secure_jwt_secret_min_32_chars_preferably_64_alphanumeric

# Admin - Contraseña inicial del usuario admin (mínimo 10 caracteres, debe ser cambiada después del primer login)
# Esta contraseña se SOLO se usa la primera vez que inicia la app para crear el admin
ADMIN_INITIAL_PASSWORD=change_this_initial_admin_password_min_10_chars
